
<mujoco model="TB3-WafflePi scene">
  <include file="turtlebot3_waffle_pi.xml"/>

  <statistic center="0 0 0.4" extent="7"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6"
               ambient="0.3 0.3 0.3"
               specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-35"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient"
             rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>

    <texture type="2d" name="groundplane"
             builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4"
             rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
  <!-- Groundplane texture, 0= opaque 1= reflectance -->
    <material name="groundplane"
              texture="groundplane"
              texuniform="true"
              texrepeat="5 5"
              reflectance="0"/>

<!-- cal_checkerboard -->
      <texture name="cal_checkerboard" type="2d" file="textures/cal_checkerboard.png" />
      <material name="cal_checkerboard_material" texture="cal_checkerboard" specular="0.1" shininess="0.1"/>

<!-- Aruco tags -->

     <texture name="aruco_texture_00" type="2d" file="textures/aruco_00.png"/>
     <material name="aruco_material_00" texture="aruco_texture_00" specular="0.1" shininess="0.1"/>


     <texture name="aruco_texture_99" type="2d" file="textures/aruco_99.png"/>
     <material name="aruco_material_99" texture="aruco_texture_99" specular="0.1" shininess="0.1"/>

     


  </asset>



  <worldbody>
    <light pos="0 0 4"
           dir="0 0 -1"
           directional="true"/>

    <!-- Existing floor -->
    <geom name="floor"
          type="plane"
          size="0 0 0.05"
          material="groundplane"/>

    <!-- 6m x 6m room walls -->
    <geom name="north_wall"
          type="box"
          pos="0 3 0.5"
          size="3 0.1 0.5"
          rgba="0.7 0.7 0.7 1"/>

    <geom name="south_wall"
          type="box"
          pos="0 -3 0.5"
          size="3 0.1 0.5"
          rgba="0.7 0.7 0.7 1"/>

    <geom name="east_wall"
          type="box"
          pos="3 0 0.5"
          size="0.1 3 0.5"
          rgba="0.7 0.7 0.7 1"/>

    <geom name="west_wall"
          type="box"
          pos="-3 0 0.5"
          size="0.1 3 0.5"
          rgba="0.7 0.7 0.7 1"/>

    <!-- Obstacles -->
    <geom name="obstacle_1"
          type="box"
          pos="-1 1 0.3"
          size="0.5 0.4 0.3"
          rgba="0.9 0.3 0.2 1"/>

    <geom name="obstacle_2"
          type="box"
          pos="1 0 0.3"
          size="0.4 0.5 0.3"
          rgba="0.2 0.4 0.9 1"/>

    <geom name="obstacle_3"
          type="box"
          pos="-1 -1.5 0.3"
          size="0.5 0.3 0.3"
          rgba="0.9 0.7 0.2 1"/>

    <!-- Charging station placeholder -->
    <!--          Grey Block        -->
    <geom name="charging_station"
          type="box"
          pos="2.4 2.65 0.1"
          size="0.35 0.15 0.1"
          rgba="0.5 0.5 0.5 1"/>

     <geom name="charging_area"
          type="box"
          pos="2.4 2.15 0.01"
          size="0.35 0.35 0.01"
          rgba="0.1 0.8 0.3 0.05"
          contype="0"
          conaffinity="0"/>


    <geom name="calibration_marker"
          type="box"
          pos="0 2.7 0.5"
          size="0.556 0.001 0.359"
          material="cal_checkerboard_material"/>


    <!-- 100x100mm Dock Tag -->
    <geom name="aruco_marker_00"
          type="box"
          pos="2.4 2.5 0.3"
          size="0.1 0.001 0.1"
          material="aruco_material_00"/>


    <!-- 50x50mm Fine Dock Tag -->
    <geom name="aruco_marker_99"
          type="box"
          pos="2.4 2.5 0.1"
          size="0.05 0.001 0.05"
          material="aruco_material_99"/>
      
  </worldbody>
</mujoco>
