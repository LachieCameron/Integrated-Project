<mujoco model="turtlebot3_waffle_pi">
  <compiler angle="radian" meshdir="stl_models/"/>

  <option cone="elliptic" impratio="10" integrator="implicitfast"/>

  <asset>
    <material name="grey" rgba="0.3 0.3 0.3 1"/>
    <material name="black" rgba="0.1 0.1 0.1 1"/>

    <mesh name="waffle_pi_base" file="waffle_pi_base.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_tire" file="left_tire.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_tire" file="right_tire.stl" scale="0.001 0.001 0.001"/>
    <mesh name="lds" file="lds.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <default>
    <!-- Wheel motor -->
    <default class="wheel">
      <joint limited="false" frictionloss="0.1" armature="0.01"/>
      <velocity kv="5" ctrlrange="-7.88 7.88" ctrllimited="true"/>
      <default class="wheel_left">
        <joint axis="0 0 1"/>
      </default>
      <default class="wheel_right">
        <joint axis="0 0 1"/>
      </default>
    </default>
    <!-- Visual / Collision -->
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" density="0" group="2"/>
    </default>
    <default class="collision">
      <geom group="3" type="mesh"/>
    </default>
  </default>

  <worldbody>
    <body name="base" pos="0 0 0">
      <inertial pos="-0.064 0 0.06" mass="1.8" diaginertia="0.01 0.01 0.008"/>
      <joint type="free" name="base_joint"/>
      <geom pos="-0.064 0 0.01" mesh="waffle_pi_base" material="black" class="visual"/>
      <geom pos="-0.064 0 0.01" mesh="waffle_pi_base" class="collision"/>
      <geom size="0.005" pos="-0.177 -0.064 0.005" type="sphere" material="grey" friction="0.0001 0.0001 0.0001" solref="0.02 1" solimp="0.95 0.99 0.001" condim="1"/>
      <geom size="0.005" pos="-0.177 0.064 0.005" type="sphere" material="grey" friction="0.0001 0.0001 0.0001" solref="0.02 1" solimp="0.95 0.99 0.001" condim="1"/>
      <geom pos="-0.049 0 0.1255" mesh="lds" material="black" class="visual"/>
      <geom pos="-0.049 0 0.1255" mesh="lds" class="collision"/>
      <geom size="0.0075 0.015 0.0135" pos="0.078 0 0.107" type="box" material="grey"/>



      <camera name= "raspi_cam_v2.1" pos= "0.078 0 0.107" fovy="48.8"/>


      <site name="imu_site" pos="-0.064 0 0.06" size="0.01" type="sphere" rgba="1 0 0 0.5"/>




      <body name="wheel_left" pos="0 0.144 0.033" quat="0.707388 -0.706825 0 0">
        <inertial pos="0 0 0" quat="-0.000890159 0.706886 0.000889646 0.707326" mass="0.0284989" diaginertia="2.07126e-05 1.11924e-05 1.11756e-05"/>
        <joint name="wheel_left" class="wheel_left"/>
        <geom quat="0.707388 0.706825 0 0" mesh="left_tire" material="grey" class="visual"/>
        <geom quat="0.707388 0.706825 0 0" mesh="left_tire" class="collision" friction="3 0.005 0.0001"/>
      </body>
      <body name="wheel_right" pos="0 -0.144 0.033" quat="0.707388 -0.706825 0 0">
        <inertial pos="0 0 0" quat="-0.000890159 0.706886 0.000889646 0.707326" mass="0.0284989" diaginertia="2.07126e-05 1.11924e-05 1.11756e-05"/>
        <joint name="wheel_right" class="wheel_right"/>
        <geom quat="0.707388 0.706825 0 0" mesh="right_tire" material="grey" class="visual"/>
        <geom quat="0.707388 0.706825 0 0" mesh="right_tire" class="collision" friction="3 0.005 0.0001"/>
      </body>
    </body>
  </worldbody>

   # kv is the velocity gain, which determines how quickly the wheel responds to control inputs. A higher kv value results in faster response, while a lower value results in slower response.
  <actuator>
    <velocity class="wheel_left" name="wheel_left" joint="wheel_left"    kv="10"/>
    <velocity class="wheel_right" name="wheel_right" joint="wheel_right" kv="10"/>
  </actuator>

  <contact>
    <exclude body1="base" body2="wheel_left"/>
    <exclude body1="base" body2="wheel_right"/>
  </contact>

  # Sensors
  <sensor>
    <!-- Wheel encoders-->
    <jointpos name="wheel_left_encoder" joint="wheel_left"/>
    <jointpos name="wheel_right_encoder" joint="wheel_right"/>
    <jointvel name="wheel_left_velocity" joint="wheel_left"/>
    <jointvel name="wheel_right_velocity" joint="wheel_right"/>

    <!-- IMU (MPU9250/ICM-20648)-->
    <accelerometer name="imu_accel" site="imu_site"/>
    <gyro name="imu_gyro" site="imu_site"/>

    <!-- LIDAR (LDS_02) 16~800cm-->
    <rangefinder name="lidar_-90" site="lidar_-90" cutoff="3.0" />
    <rangefinder name="lidar_-75" site="lidar_-75" cutoff="3.0" />
    <rangefinder name="lidar_-60" site="lidar_-60" cutoff="3.0" />
    <rangefinder name="lidar_-45" site="lidar_-45" cutoff="3.0" />
    <rangefinder name="lidar_-30" site="lidar_-30" cutoff="3.0" />
    <rangefinder name="lidar_-15" site="lidar_-15" cutoff="3.0" />
    <rangefinder name="lidar_0" site="lidar_0" cutoff="3.0" />
    <rangefinder name="lidar_15" site="lidar_15" cutoff="3.0" />
    <rangefinder name="lidar_30" site="lidar_30" cutoff="3.0" />
    <rangefinder name="lidar_45" site="lidar_45" cutoff="3.0" />
    <rangefinder name="lidar_60" site="lidar_60" cutoff="3.0" />
    <rangefinder name="lidar_75" site="lidar_75" cutoff="3.0" />

  </sensor>


</mujoco>